{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "functions": {
    "api/decide.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}

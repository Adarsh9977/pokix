# ---------------------------------------------------------------------------
# Jev Arena environment configuration
#
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit a real API key.
# The TypeSafe API key is read server-side only and is never sent to the
# browser. On a deployment, set these in your host's environment variables
# rather than in a file.
# ---------------------------------------------------------------------------

# ---- TypeSafe / Jev ------------------------------------------------------
# Required for: the Jev playground, `npm run match`, Jev mode in the web app,
# and the opt-in live tests. Everything else works without it.
# Variable names follow the TypeSafe JavaScript SDK (`ENV` in the SDK docs).
TYPESAFE_API_KEY=

# Optional. The SDK defaults are shown; leave commented out to use them.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=warn

# ---- Agents --------------------------------------------------------------
# Which agents to use by default.
#
#   mock  deterministic local agents. No network, no cost.  (default)
#   jev   real Jev agents. Two API requests per turn.
#
# Applies to `npm run match` and to the mode the web app starts in.
# Setting `jev` without a key is ignored rather than obeyed: the web app
# falls back to mock and tells you why, and `npm run match` refuses with a
# clear message instead of failing every turn.
#
# Overrides: `npm run match -- --mock` / `-- --jev`, and the toggle in the UI.
AGENT_MODE=mock

# ---- Opt-in live tests ----------------------------------------------------
# `npm test` must never call the network or spend credits, so the live
# TypeSafe tests self-skip unless this is exactly `true`.
#
#   npm test                          offline, free
#   RUN_LIVE_JEV_TESTS=true npm test  also runs the live API tests
#   npm run test:live                 the same thing, spelled shorter
#
# This is independent of AGENT_MODE. Setting AGENT_MODE=jev does not enable
# live tests, and enabling live tests does not change how a match runs.
RUN_LIVE_JEV_TESTS=false

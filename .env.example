# ---------------------------------------------------------------------------
# Jev Arena environment configuration
#
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit a real API key.
# The TypeSafe API key is read server-side only and is never sent to the browser.
# ---------------------------------------------------------------------------

# ---- TypeSafe / Jev ------------------------------------------------------
# Required for the Jev playground, the JevAgent adapter and live API tests.
# Variable names follow the TypeSafe JavaScript SDK (`ENV` in the SDK docs).
TYPESAFE_API_KEY=

# Optional. The SDK defaults are shown; leave commented out to use them.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=warn

# ---- Agents --------------------------------------------------------------
# `mock`  - fully deterministic, never calls the TypeSafe API (default)
# `jev`   - real Jev agents, consumes API tokens
AGENT_MODE=mock

# ---- Opt-in live API tests ----------------------------------------------
# Normal `npm test` must never call the network or spend credits.
# Set to `true` only when you explicitly want to exercise the live API.
RUN_LIVE_JEV_TESTS=false

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // tsx resolves these when running the CLI scripts, so `npm run match`
    // and friends execute TypeScript source rather than a stale bundle.
    "baseUrl": ".",
    "paths": {
      "@jev-arena/types": ["./packages/types/src/index.ts"],
      "@jev-arena/game-core": ["./packages/game-core/src/index.ts"],
      "@jev-arena/agent-core": ["./packages/agent-core/src/index.ts"],
      "@jev-arena/server": ["./apps/server/src/index.ts"]
    },

    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "apps/*/src/**/*",
    "apps/*/tests/**/*",
    "scripts/**/*",
    "tests/**/*",
    "api/**/*",
    "*.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "apps/web"]
}

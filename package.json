{
  "name": "jev-arena",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-vs-AI tactical arena. A deterministic game engine plus two autonomous TypeSafe/Jev agents making simultaneous typed decisions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "build": "npm run typecheck && npm run build -w @jev-arena/web",
    "dev": "npm run dev -w @jev-arena/web",
    "simulate": "tsx scripts/simulate.ts",
    "jev:playground": "tsx scripts/jev-playground.ts",
    "match": "tsx scripts/match.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "RUN_LIVE_JEV_TESTS=true vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.9",
    "@vercel/node": "^5.1.14",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
